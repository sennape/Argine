+/* R3-02A portability shim: the Argine route-log worker (patch 0001) uses GCC
+ * __atomic builtins, which MSVC does not provide. The MSVC branch below maps
+ * the same three operations onto the equivalent interlocked intrinsics with
+ * the same acquire/release semantics; the GCC/Clang path is unchanged. This
+ * is a build-portability shim only: no algorithm, decision or timing logic
+ * is altered. */
+#if defined(_MSC_VER)
+#include <intrin.h>
+#define ARGINE_ATOMIC_LOAD_ACQUIRE(ptr) \
+    ((int) _InterlockedCompareExchange((volatile long *) (ptr), 0, 0))
+#define ARGINE_ATOMIC_STORE_RELEASE(ptr, val) \
+    ((void) _InterlockedExchange((volatile long *) (ptr), (long) (val)))
+#define ARGINE_ATOMIC_TEST_AND_SET(ptr, expected) \
+    ((_InterlockedCompareExchange((volatile long *) (ptr), 1, (long) (*(expected))) == (long) (*(expected))) ? 1 : 0)
+#else
+#define ARGINE_ATOMIC_LOAD_ACQUIRE(ptr) __atomic_load_n((ptr), __ATOMIC_ACQUIRE)
+#define ARGINE_ATOMIC_STORE_RELEASE(ptr, val) __atomic_store_n((ptr), (val), __ATOMIC_RELEASE)
+#define ARGINE_ATOMIC_TEST_AND_SET(ptr, expected) \
+    __atomic_compare_exchange_n((ptr), (expected), 1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)
+#endif
 #include <errno.h>
 #include <time.h>
 #include <math.h>
