{
  "schema_version": 1,
  "contract_version": "r2-09b-decision-rules-v1",
  "dev_eval_firewall": {
    "dev_allowed": [
      "inspect",
      "algorithm development",
      "baseline-family comparison",
      "hyperparameter selection",
      "predictor architecture/model selection on DEV",
      "threshold methodology derivation only if explicitly permitted; numeric engineering threshold not fabricated"
    ],
    "eval_forbidden_before_freeze_and_open": [
      "tune baseline/predictor parameters on EVAL",
      "revise primary metric using EVAL",
      "revise materiality threshold using EVAL",
      "revise success/falsification criteria using EVAL",
      "add/remove candidate algorithms using EVAL and report as held-out"
    ],
    "post_eval_failure": "If EVAL reveals failure and a new method is developed, that is a new experimental generation/version; old EVAL becomes DEV/observed for the new generation and a new held-out EVAL is required for fresh confirmatory claims."
  },
  "b_selected_rule": {
    "selected_from": "DEV_ONLY",
    "primary_rule_id": "B_selected_M",
    "definition": "B_selected(M) is the preregistered causal baseline family+frozen hyperparameters with lowest aggregate DEV miss bytes at primary budget M across preregistered DEV workload families under the deterministic condition, tie-break by lower aggregate misses then stable lexical family/config id. Selected/frozen before EVAL inspection.",
    "family_conditioned_secondary": "B_selected(M,W_class) may be reported as secondary diagnostic only if workload family/class is observable before retention decisions and the conditioning rule is preregistered/frozen before DEV tuning; not required for primary claims.",
    "eval_hindsight_diagnostic_only": true,
    "b_oracle_family_on_eval": "hindsight best among preregistered causal baselines on EVAL; diagnostic only; NEVER deployable selected baseline; NEVER used as primary predictor comparison.",
    "primary_predictor_comparison": "DEV-selected B_selected(M) (and preregistered continuity baselines) only."
  },
  "falsification": {
    "prediction_benchmark": [
      "SUPPORTED",
      "FALSIFIED",
      "INCONCLUSIVE"
    ],
    "retention_improvement": [
      "SUPPORTED",
      "FALSIFIED",
      "INCONCLUSIVE"
    ],
    "engineering_materiality": [
      "SUPPORTED",
      "FALSIFIED",
      "NOT_EVALUABLE_PENDING_CALIBRATION"
    ],
    "no_vague_significance": true,
    "aggregate_rule": "Primary confirmatory claims require preregistered per-cell reporting. Any aggregate claim must report all primary (M,W_class,deterministic) cells; an aggregate improvement must not hide systematic losses on a workload family. Exact aggregate pass rule for R2-11 confirmatory retention claim: no systematic loss on any primary workload family at a budget where comparison is valid, and aggregate DEV-selected scientific improvement direction holds on the primary deterministic set, subject to frozen cell definitions. Engineering materiality remains NOT_EVALUABLE_PENDING_CALIBRATION unless policy-stream performance calibration is frozen and passed."
  },
  "classification": {
    "primary_confirmatory": [
      "B_selected(M) vs P on miss bytes per primary (M,W_class) deterministic",
      "primary prediction metric on next-step same-layer target"
    ],
    "secondary": [
      "recovery_vs_lru",
      "RecoveryOfBeladyGap (CASE C)",
      "short-horizon targets h=4,16",
      "byte-weighted/ranking prediction diagnostics",
      "family-conditioned B_selected diagnostic"
    ],
    "exploratory": [
      "any non-preregistered model/horizon/metric/threshold added after observing EVAL; must be labeled exploratory and cannot rescue failed primary hypothesis"
    ]
  },
  "reporting_granularity": {
    "primary_unit": "budget_x_workload",
    "required_fields_per_cell": [
      "budget",
      "workload family/spec",
      "decoding condition",
